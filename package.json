{
  "name": "darkshield",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "extension"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <13"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @darkshield/web",
    "dev:extension": "npm run dev --workspace @darkshield/extension",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace @darkshield/web",
    "build:extension": "npm run build --workspace @darkshield/extension",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build",
    "test": "npm run test --workspace @darkshield/web && npm run test --workspace @darkshield/extension --if-present",
    "test:coverage": "npm run test:coverage --workspace @darkshield/web && npm run test:coverage --workspace @darkshield/extension --if-present",
    "test:db": "supabase test db",
    "supabase:check": "npm run supabase:check --workspace @darkshield/web",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "supabase": "3.1.0",
    "typescript": "5.9.3"
  }
}
